# Configurações do Servidor
PORT=5000
NODE_ENV=development

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:3000

# JWT Secret (use uma string longa e aleatória em produção)
JWT_SECRET=seu-secret-jwt-muito-seguro-aqui

# Configurações de Banco de Dados (se usar MongoDB)
MONGODB_URI=mongodb://localhost:27017/verde-sabor

# Configurações de Email (se usar notificações)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=sua-senha-app
EMAIL_FROM=Verde & Sabor <contato@verdesabor.com.br>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Upload de Arquivos
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/

# WebSocket
WEBSOCKET_ENABLED=true
